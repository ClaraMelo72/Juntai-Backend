NODE_ENV=development
PORT=3333

# Banco local (Postgres do docker-compose expoe a porta 5433 no host).
# Dentro do container da API, o docker-compose sobrescreve estas variaveis.
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=juntai_db

# Autenticacao (JWT). Gere um segredo proprio com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d
