NODE_ENV=development
PORT=3333

# Banco local (Postgres do docker-compose expoe a porta 5433 no host).
# Dentro do container da API, o docker-compose sobrescreve estas variaveis.
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=juntai_db

# Autenticacao (JWT). Gere um segredo proprio com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# Servico interno; nunca usar URL do FastAPI no frontend.
MATCHMAKING_API_URL=http://127.0.0.1:8000
MATCHMAKING_TIMEOUT_MS=5000
# Padrão seguro: Nível 1A. supervised é experimental e requer ativação explícita.
MATCHMAKING_STRATEGY=rules
